{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "includeFiles": "public/**" } }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.js" }
  ],
  "crons": [
    { "path": "/api/discord/poll-boss-kills", "schedule": "0 0 * * *" },
    { "path": "/api/discord/poll-cave-attendance", "schedule": "30 0 * * *" }
  ]
}
